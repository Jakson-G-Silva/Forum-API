@baseUrl = http://localhost:3333
@auth_token = {{authenticate_user.response.body.access_token}}

# @name create_account
POST {{baseUrl}}/accounts
Content-Type: application/json

{
  "name": "Usuario Teste",
  "email": "usuario.teste5@example.com",
  "password": "123456"
}

###

# @name authenticate_user
POST {{baseUrl}}/sessions
Content-Type: application/json

{
  "email": "usuario.teste4@example.com",
  "password": "123456"
}

###

# @name create_question
POST {{baseUrl}}/questions
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "title": "pergunta 26",
  "content": "I would like to know how to use NestJS with an HTTP client. Can someone help?"
}
###

# @name fetch_recent_questions
GET {{baseUrl}}/questions
Content-Type: application/json
Authorization: Bearer {{auth_token}}


